rules_version = '2';

// Reglas de seguridad de la base de datos.
// Copia este archivo entero en Firebase console → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Dueño: puede hacerlo todo (correo verificado)
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'o39459309@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Co-dueño: el dueño le da el rango en el panel (roles/{uid}) y su correo tiene que estar verificado
    function isCoOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'coowner';
    }

    // Permisos del co-dueño (los marca el dueño en Roles). Sin lista: solo pedidos y chats.
    function can(p) {
      return isOwner() || (isCoOwner() && (
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('perms', null) == null
          ? (p == 'orders' || p == 'chats')
          : get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.perms.get(p, false) == true));
    }

    // Cuentas baneadas (panel → Ban): no pueden pedir ni chatear. Con "until", el ban caduca solo.
    function isBanned() {
      return signedIn()
        && exists(/databases/$(database)/documents/bans/$(request.auth.token.email))
        && (get(/databases/$(database)/documents/bans/$(request.auth.token.email)).data.get('until', null) == null
            || get(/databases/$(database)/documents/bans/$(request.auth.token.email)).data.until > request.time);
    }

    function isStaff() {
      return isOwner() || isCoOwner();
    }

    function shortString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // ---------- Perfiles de usuario ----------
    match /users/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'username', 'email', 'createdAt'])
        && shortString(request.resource.data.name, 1, 60)
        && request.resource.data.email == request.auth.token.email
        // el usuario tiene que ser suyo de verdad (reservado en /usernames)
        && (!('username' in request.resource.data)
            || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid);
      allow delete: if isOwner();
    }

    // ---------- Rangos (los da el dueño en el panel → Roles) ----------
    match /roles/{uid} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow list: if isOwner();
      allow write: if isOwner();
    }

    // ---------- Baneos ----------
    // Banea el dueño (o el co-dueño con permiso). Cada uno puede comprobar si él mismo está baneado.
    match /bans/{email} {
      allow get: if isStaff() || (signedIn() && request.auth.token.email == email);
      allow list: if can('bans');
      allow write: if can('bans') && email != 'o39459309@gmail.com';
    }

    // ---------- Nombres de usuario (para que no se repitan) ----------
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner();
    }

    // ---------- Ajustes de la tienda ----------
    // Todos los ven; los cambia el dueño o el co-dueño con el permiso de esa parte
    match /settings/{id} {
      allow read: if true;
      allow write: if isOwner()
        || (id == 'shop' && can('prices'))
        || (id == 'offers' && can('offers'))
        || (id == 'codes' && can('codes'))
        || (id == 'notices' && can('notices'))
        || (id == 'emojis' && can('emojis'));
    }

    // ---------- Ficha de cada producto (descripción y fotos) ----------
    match /products/{pid} {
      allow read: if true;
      allow write: if can('prices');
    }

    // ---------- Stock de cada producto ----------
    // Lo ven todos. El equipo lo cambia como quiera.
    // Un amigo solo puede: restar lo que se lleva en un pedido nuevo (dejando una
    // reserva en holds/{pedido}) o devolver exactamente esa reserva al cancelarlo.
    match /stock/{pid} {
      function holdPath(orderId) {
        return /databases/$(database)/documents/stock/$(pid)/holds/$(orderId);
      }
      function orderPath(orderId) {
        return /databases/$(database)/documents/orders/$(orderId);
      }

      allow read: if true;
      allow write: if can('prices') || can('orders');
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'lastOrder'])
        && request.resource.data.qty is int
        && request.resource.data.qty >= 0
        && (
          // coger stock para un pedido nuevo
          (!exists(orderPath(request.resource.data.lastOrder))
            && getAfter(orderPath(request.resource.data.lastOrder)).data.uid == request.auth.uid
            && request.resource.data.qty == resource.data.qty
                 - getAfter(holdPath(request.resource.data.lastOrder)).data.qty)
          // devolverlo al cancelar (la reserva desaparece a la vez)
          || (exists(holdPath(request.resource.data.lastOrder))
            && !existsAfter(holdPath(request.resource.data.lastOrder))
            && get(holdPath(request.resource.data.lastOrder)).data.uid == request.auth.uid
            && request.resource.data.qty == resource.data.qty
                 + get(holdPath(request.resource.data.lastOrder)).data.qty)
        );

      // Reservas: cuánto stock ha sacado cada pedido
      match /holds/{orderId} {
        allow read: if isStaff() || (signedIn() && resource.data.uid == request.auth.uid);
        allow write: if can('prices') || can('orders');
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'qty'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.qty is int
          && request.resource.data.qty > 0
          && !exists(orderPath(orderId))
          && getAfter(orderPath(orderId)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/stock/$(pid)).data.lastOrder == orderId;
        allow delete: if signedIn()
          && resource.data.uid == request.auth.uid
          && getAfter(orderPath(orderId)).data.status == 'cancelado'
          && getAfter(/databases/$(database)/documents/stock/$(pid)).data.lastOrder == orderId;
      }
    }

    // ---------- Chat de cada amigo con el vendedor ----------
    match /chats/{uid} {
      allow read: if can('chats') || (signedIn() && request.auth.uid == uid);
      allow create, update: if can('chats')
        || (signedIn()
            && !isBanned()
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly([
                 'uid', 'userName', 'userEmail', 'lastText', 'lastAt', 'lastFrom',
                 'lastBy', 'unreadAdmin', 'unreadUser'])
            && request.resource.data.uid == uid
            && request.resource.data.userEmail == request.auth.token.email
            && shortString(request.resource.data.userName, 1, 60)
            && shortString(request.resource.data.lastText, 0, 120)
            && request.resource.data.lastFrom == 'user')
        // el amigo marca como leídos los mensajes del vendedor
        || (signedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadUser'])
            && request.resource.data.unreadUser == 0);
      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if can('chats') || (signedIn() && request.auth.uid == uid);
        // el dueño y el co-dueño mandan texto y fotos (con su etiqueta); el amigo, solo texto
        allow create: if (can('chats')
              && request.resource.data.keys().hasOnly(['from', 'by', 'text', 'photos', 'createdAt'])
              && request.resource.data.from == 'admin'
              && request.resource.data.by == (isOwner() ? 'owner' : 'coowner'))
          || (signedIn()
              && !isBanned()
              && request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
              && request.resource.data.from == 'user'
              && shortString(request.resource.data.text, 1, 1000)
              && request.resource.data.createdAt == request.time);
        allow delete: if isOwner();
      }
    }

    // ---------- Entradas y recargas (para analíticas) ----------
    match /visits/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'kind', 'reason', 'device', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.kind in ['entrada', 'manual', 'auto', 'memoria', 'error']
        && shortString(request.resource.data.name, 0, 60)
        && shortString(request.resource.data.reason, 0, 200)
        && shortString(request.resource.data.device, 0, 120)
        && request.resource.data.at == request.time;
      allow read: if can('stats');
      allow delete: if isOwner();
    }

    // ---------- Pedidos ----------
    match /orders/{orderId} {
      allow read: if can('orders') || can('stats') || can('money')
        || (signedIn() && resource.data.uid == request.auth.uid);

      // Los pedidos entran ya aceptados (sin pagar). El precio calculado va en
      // "estimate"; el precio de verdad ("total") solo lo pone el equipo.
      allow create: if signedIn()
        && !isBanned()
        && request.resource.data.keys().hasOnly([
             'uid', 'userName', 'userEmail', 'description', 'offer',
             'items', 'keychain', 'promoCode', 'status', 'estimate', 'fromStock', 'paid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && shortString(request.resource.data.userName, 1, 60)
        && shortString(request.resource.data.description, 0, 1000)
        && request.resource.data.items is map
        && request.resource.data.items.size() <= 20
        && shortString(request.resource.data.offer, 0, 40)
        && shortString(request.resource.data.promoCode, 0, 30)
        && request.resource.data.keychain is bool
        && request.resource.data.status == 'aceptado'
        && (!('estimate' in request.resource.data)
            || (request.resource.data.estimate is number
                && request.resource.data.estimate >= 0
                && request.resource.data.estimate <= 1000))
        && (!('fromStock' in request.resource.data)
            || (request.resource.data.fromStock is map && request.resource.data.fromStock.size() <= 20))
        && request.resource.data.paid == false
        && request.resource.data.createdAt == request.time;

      // El dueño puede cambiarlo todo; el co-dueño lo de sus permisos (pedidos y/o pagos);
      // el amigo puede cancelar su pedido mientras no esté listo ni pagado
      allow update: if isOwner()
        || (can('orders')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'status', 'price', 'discountPct', 'total', 'pickupTime', 'pickupPlace',
                 'adminNote', 'acceptedAt', 'deliveredAt', 'progress', 'updatesCount',
                 'lastUpdateAt', 'stockReturned', 'cancelledAt']))
        || (can('money')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'paidAt']))
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && resource.data.status in ['pendiente', 'aceptado']
            && resource.data.paid == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'stockReturned'])
            && request.resource.data.status == 'cancelado');

      allow delete: if isOwner();

      // Novedades del pedido (cómo va + fotos): las publica el equipo,
      // y solo el amigo que hizo el pedido las puede ver
      match /updates/{updateId} {
        allow read: if can('orders')
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow write: if can('orders');
      }
    }
  }
}
